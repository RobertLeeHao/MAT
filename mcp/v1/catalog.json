{
  "schema": "mat-mcp-catalog/2",
  "updated": "2026-10-15",
  "about": "Servers MAT offers on Settings › Tools › Browse. Only reviewed entries ship. Every entry says up front whether it works today (ready), needs something the user must get first (needs-setup), or cannot be used yet (unavailable) — so nobody finds out halfway.",
  "availability": {
    "ready": "Tick and go; at most a sign-in or a free account on that service.",
    "needs-setup": "Works, but needs something first: a paid key, an app approved by the company admin, or a real-name developer account. The reason is shown before ticking.",
    "unavailable": "Listed so people know it exists, not tickable. The reason says what MAT itself still has to do."
  },
  "categories": {
    "files": "Files",
    "browser": "Browser",
    "web": "Web & search",
    "docs": "Docs",
    "work": "Work",
    "comms": "Mail & chat",
    "code": "Code",
    "design": "Design",
    "data": "Data",
    "money": "Payments",
    "maps": "Maps"
  },
